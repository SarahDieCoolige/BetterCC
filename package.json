{
  "name": "bettercc",
  "version": "3.0.1",
  "description": "Tampermonkey userscript that enhances ChatCity.de",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "node dev/server.mjs",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'css/**/*.css' '*.mjs' '*.json'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'css/**/*.css' '*.mjs' '*.json'",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@types/tinycolor2": "^1.4.6",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/tampermonkey": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
